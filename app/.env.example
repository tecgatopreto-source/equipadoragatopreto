# ── Banco de dados ────────────────────────────────────────────────────────────
# Supabase → Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.SEU_PROJECT_ID:SUA_SENHA@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# ── Autenticação JWT ──────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=seu-jwt-secret-aqui-minimo-48-chars

# ── Supabase Auth ─────────────────────────────────────────────────────────────
# Supabase → Settings → API
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=...

# ── Google Custom Search (busca automática de imagens) ────────────────────────
# 1. console.cloud.google.com → Biblioteca → "Custom Search JSON API" → Ativar → Credenciais → Criar chave
# 2. cse.google.com → Novo motor de busca → ativar "Pesquisa de imagens" → copiar ID do motor
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ── Opcionais ─────────────────────────────────────────────────────────────────
PORT=3001
# UPLOAD_DIR=/caminho/absoluto/para/uploads
# NODE_ENV=production  ← em produção vem do ecosystem.config.js (PM2), não deste arquivo.
#   Esconde o stack trace na página de erro do Express e trava o LOGIN_LOCAL (abaixo).
#   NÃO liga o cookie Secure: ele é fixo em false enquanto a produção for HTTP sem TLS
#   (middleware/auth.js).

# ── Só na máquina de desenvolvimento ─────────────────────────────────────────
# Liga o formulário de senha na página /login. No local a Central roda em outra
# porta (outra origem), então o login único não enxerga a sessão gp_session.
# NUNCA no servidor: com NODE_ENV=production o servidor se recusa a subir.
# LOGIN_LOCAL=1
